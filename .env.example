# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env 는 .gitignore 에 들어 있어요)
# 값 뒤에 따옴표·공백·주석을 붙이지 마세요.  예) ANTHROPIC_API_KEY=sk-ant-xxxx
# 서버(/api)에서만 쓰는 비밀 키에는 절대 VITE_ 를 붙이지 마세요.
# Vercel 에도 아래 이름 그대로 환경변수로 입력합니다 (README 의 '배포' 참고).

# ═══ 1. Claude — AI 에이전트 (필수) ═══════════════════════════
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ═══ 2. 기상청 단기예보 — 공공데이터포털 (권장) ════════════════
# 사용처: server/kma.js → 공식 하늘상태·강수확률
# 포털: 「기상청_단기예보 ((구)동네예보) 조회서비스」 활용신청 후, 마이페이지의 일반 인증키(Decoding)
DATA_GO_KR_KEY_KMA=

# ═══ 3. 한국관광공사 국문 관광정보 — 공공데이터포털 (선택) ═════
# 사용처: server/tour.js → 명소 카드 사진, scripts/find-coords.mjs → 명소 좌표 찾기
# 포털: 「한국관광공사_국문 관광정보 서비스_GW」 활용신청 후, 같은 마이페이지의 일반 인증키(Decoding)
# (포털 키는 하나라서 2번과 같은 값을 넣어도 돼요. 이름만 나눠 어떤 API 용인지 알아보기 쉽게 한 거예요)
DATA_GO_KR_KEY_KTO=

# ═══ 4. 제주관광공사 비짓제주 관광정보 — NEARBY 탭 (선택) ══════
# 사용처: server/visitjeju.js → 명소 주변 관광지·음식점·숙박
# 주의: 공공데이터포털 키가 아니에요. https://www.visitjeju.net/kr/visitjejuapi 에서 사용신청 → 담당자 승인 후 메일로 받는 자체 apiKey
VISITJEJU_API_KEY=

# ═══ 5. Supabase — 즐겨찾기·대화 기록 저장 (필수) ══════════════
# Project Settings → API  (anon public 키는 브라우저에 들어가도 되는 공개용이라 VITE_ 가 붙어요)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ═══ 키가 필요 없는 API (여기에 넣을 것 없음) ═════════════════
#   · sunrise-sunset.org v2  — 일출·일몰·골든아워
#   · Open-Meteo 예보·바다·지오코딩 — 구름양·파도·좌표 검색
